<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <appender name="CONSOLE_TEXT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} [%thread] %-5level [cid:%X{correlationId:-none}] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="CONSOLE_JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
            <layout class="com.payrail.config.JsonLoggingLayout"/>
        </encoder>
    </appender>

    <springProfile name="prod | json">
        <root level="INFO">
            <appender-ref ref="CONSOLE_JSON"/>
        </root>
    </springProfile>

    <springProfile name="!(prod | json)">
        <root level="INFO">
            <appender-ref ref="CONSOLE_TEXT"/>
        </root>
    </springProfile>

    <logger name="com.payrail" level="DEBUG"/>
    <logger name="org.springframework.web" level="INFO"/>
    <logger name="org.flywaydb" level="INFO"/>
</configuration>
