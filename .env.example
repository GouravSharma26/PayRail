# PayRail Environment Configuration Example
# Synthetic-Only Payment Simulator - No real credentials or financial connections

# Application Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (PostgreSQL)
POSTGRES_PORT=5432
DB_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/payrail_db
SPRING_DATASOURCE_USERNAME=payrail_user
SPRING_DATASOURCE_PASSWORD=payrail_secret

# Event Broker Configuration (Apache Kafka / Redpanda)
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
PAYRAIL_TOPICS_TRANSFER_COMMANDS=payrail.transfer-commands.v1
PAYRAIL_TOPICS_TRANSFER_COMMANDS_DLQ=payrail.transfer-commands.dlq.v1

# Outbox Publisher Configuration
PAYRAIL_OUTBOX_BATCH_SIZE=50
PAYRAIL_OUTBOX_LEASE_DURATION=10s
PAYRAIL_OUTBOX_POLL_INTERVAL=500ms
PAYRAIL_OUTBOX_MAX_RETRIES=5

# Payment Processing and Recovery Configuration
PAYRAIL_PROCESSING_LEASE_DURATION=30s
PAYRAIL_PROCESSING_MAX_ATTEMPTS=5
PAYRAIL_PROCESSING_INITIAL_BACKOFF=1s
PAYRAIL_PROCESSING_MAX_BACKOFF=60s
PAYRAIL_PROCESSING_RECOVERY_SWEEP_INTERVAL=15s

# Reconciliation Configuration
PAYRAIL_RECONCILIATION_INTERVAL=60s
PAYRAIL_RECONCILIATION_STALE_PROCESSING_THRESHOLD=60s
PAYRAIL_RECONCILIATION_STALE_OUTBOX_THRESHOLD=30s

# Observability and Management
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,prometheus
LOG_LEVEL_COM_PAYRAIL=INFO
